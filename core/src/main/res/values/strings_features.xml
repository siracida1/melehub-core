    <string name="update_not_enough_space">Not enough free storage for the update. Free up about <xliff:g id="size">%1$s</xliff:g> and try again.</string>
    <!-- Translators: Error when the downloaded update file is incomplete or corrupted. -->
    <string name="update_damaged_download">The update didn\'t download completely. Check your connection and try again.</string>
