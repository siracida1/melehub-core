    <string name="update_available_version">Version <xliff:g id="available">%1$s</xliff:g> is available (you have v<xliff:g id="current">%2$s</xliff:g>).</string>
    <!-- Translators: Informational text in the update dialog after download completes. -->
    <string name="update_installer">The system installer opens when the download finishes.</string>
