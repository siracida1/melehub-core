    <string name="update_later">Later</string>
    <!-- Translators: Primary button in the update dialog to start the update immediately. -->
    <string name="update_now">Update now</string>
    <!-- Translators: Button to retry checking for updates. -->
    <string name="update_try_again">Try again</string>
    <!-- Translators: Error when the update check fails due to a network issue. -->
    <string name="update_failed_check">Couldn\'t check for updates.</string>
