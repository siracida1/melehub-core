    <string name="update_invalid_release_response">The update server returned an invalid release description.</string>
    <!-- Translators: Error when the update download fails due to a network error. -->
    <string name="update_failed_download">Couldn\'t download the update because the network request failed.</string>
    <!-- Translators: Error when the update download returns an HTTP error. "code" is the HTTP status code such as 503. Keep the punctuation. -->
    <string name="update_failed_download_http">The update download returned HTTP <xliff:g id="code">%1$s</xliff:g>.</string>
    <!-- Translators: Error when the update server returns an empty APK file. -->
    <string name="update_empty_download">The update server returned an empty APK.</string>
    <!-- Translators: Error when the system installer cannot open the downloaded update. -->
    <string name="update_install_failed">The downloaded update could not be opened by the system installer.</string>
